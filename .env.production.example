MYSQL_DATABASE=nolzo
MYSQL_USERNAME=nolzo
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
REDIS_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-at-least-64-random-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password
CORS_ALLOWED_ORIGINS=http://localhost:3000
